  "keyFeatures": [
    "Full CRUD for clients, mechanics, vehicles, services, and parts",
    "Service order lifecycle management (AGENDADA → EM_ANDAMENTO → CONCLUIDA/CANCELADA)",
    "Technical diagnostic linked 1:1 to each service order",
    "Item-level approval workflow for services and parts before billing",
    "Price history invariance: applied prices are frozen at the time of item creation",
    "Paginated listings with field-level filters on all major resources",
    "Payment tracking per service order with multiple payment methods",
    "Structured error handling with custom exception hierarchy",
    "Rotating file-based structured logging via YAML configuration",
    "Alembic database migrations supporting PostgreSQL and SQLite"
  ],
  "publicApiSurface": [
